{
  "name": "@fingate/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "dev:debug": "node --inspect=9229 --watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1132.0",
    "@aws-sdk/s3-request-presigner": "3.1132.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@fastify/swagger": "9.8.1",
    "@fingate/shared": "workspace:*",
    "exceljs": "4.4.0",
    "fastify": "5.12.4",
    "mongodb": "7.6.0",
    "mongoose": "9.10.1",
    "nodemailer": "10.0.10",
    "otp": "2.0.1",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "eslint": "10.10.0",
    "mongodb-memory-server": "11.2.0",
    "pino-pretty": "13.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
