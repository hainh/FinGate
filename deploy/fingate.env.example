# FinGate — biến môi trường cho server thật (Profile O) — BẢN ĐẦY ĐỦ.
#
#   cp deploy/fingate.env.example deploy/fingate.env   # rồi điền secret
#
# deploy/fingate.env KHÔNG được commit (đã có trong .gitignore).
# Sinh secret: openssl rand -hex 32   (SESSION_SECRET, FIELD_KEY)
#              openssl rand -hex 16   (TASK_TOKEN)
#
# Mọi key trong apps/api/src/env.ts đều có mặt ở file này. Biến để trống sẽ dùng
# default của code — default được ghi trong comment ngay trên biến để dễ đối chiếu.
#
# LƯU Ý: deploy/compose.yml GHI ĐÈ các biến dưới đây (khai ở file chỉ có tác dụng
# khi chạy app NGOÀI compose, ví dụ systemd/node trực tiếp):
#   NODE_ENV, PROFILE, PORT, HOST, STORAGE_DRIVER, UPLOAD_DIR, BACKUP_DIR,
#   BACKUP_AUTO, WEB_DIST, MONGODB_URI
# Ngoài ra Caddy đọc FINGATE_DOMAIN (ở cuối file) khi chạy `--profile tls`.

# --- runtime ---
NODE_ENV=production
TZ=UTC
PORT=8080
# Interface lắng nghe (default 0.0.0.0).
HOST=0.0.0.0
# URL công khai của hệ thống — dùng để dựng URL chứng từ và bật cookie Secure.
PUBLIC_URL=https://fingate.company.com
# Đường dẫn SPA để API tự serve (compose đặt apps/web/dist). Trống = không serve SPA.
WEB_DIST=apps/web/dist
# Hiện ở /healthz và /api/v1/system/status — đổi theo bản phát hành (default 0.1.0).
VERSION=0.1.0
# fatal | error | warn | info | debug | trace (default info).
LOG_LEVEL=info

# --- database ---
# Trong compose, MONGODB_URI được ghi đè thành mongodb://mongo:27017/fingate?directConnection=true
MONGODB_URI=mongodb://mongo:27017/fingate?directConnection=true

# --- secret (bắt buộc, app fail-fast ở production nếu thiếu) ---
SESSION_SECRET=
FIELD_KEY=
TASK_TOKEN=

# --- runtime profile ---
# onprem = VPS/VM có đĩa bền · cloud = Render/PaaS (filesystem mất khi restart).
PROFILE=onprem
STORAGE_DRIVER=fs
UPLOAD_DIR=/data/uploads

# --- sao lưu MongoDB ---
# Sao lưu mongodump → thư mục này (bind-mount ra host deploy/backups/).
BACKUP_DIR=/data/backups
# Container MongoDB để chạy mongodump khi host không có MongoDB Database Tools.
# Bỏ trống = tự nhận diện container theo cổng MONGODB_URI, ưu tiên fingate-mongo.
BACKUP_MONGO_CONTAINER=
# true = sao lưu mỗi 30' ngay trong app. CHỈ bật trên ĐÚNG MỘT instance có đĩa bền.
BACKUP_AUTO=true

# --- storage cloud (TUỲ CHỌN — chỉ khi đổi STORAGE_DRIVER=s3; Profile O mặc định fs) ---
# Lưu ý: compose ghim STORAGE_DRIVER=fs, muốn dùng R2/S3 phải sửa cả compose.yml.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=fingate-docs

# --- hạn mức tài nguyên (giá trị đang là default của code) ---
# request tối đa / phút / IP.
RATE_LIMIT_MAX=300
# 25 MB / file tải lên.
MAX_UPLOAD_BYTES=26214400
# 5 GB dung lượng chứng từ / công ty (trần R2 free 10 GB, arch §19.2-7).
COMPANY_STORAGE_BYTES=5368709120
# export trực tiếp quá số dòng này sẽ chạy thành job nền (arch §14).
EXPORT_ROW_LIMIT=50000
# TTL cache in-memory cho badge/dashboard, tính bằng ms (arch §8.3).
CACHE_TTL_MS=60000

# --- phiên đăng nhập (arch §7.2, ADR-19) ---
# Mặc định MỌI phiên là loại "ghi nhớ" (remember=true) với HẠN CUỘN theo
# SESSION_REMEMBER_DAYS → người dùng hoạt động định kỳ không phải đăng nhập lại.
# 400 là trần Max-Age của trình duyệt, đặt lớn hơn cũng bị cắt về 400.
SESSION_REMEMBER_DAYS=400
# CHỈ áp dụng khi người dùng BỎ CHỌN "Ghi nhớ đăng nhập" ở màn đăng nhập.
# (default của code nếu bỏ trống: idle 1440 phút · absolute 168 giờ)
SESSION_IDLE_MINUTES=15
SESSION_ABSOLUTE_HOURS=8
# Chống dò mật khẩu: sai quá LOGIN_MAX_ATTEMPTS lần → khoá LOGIN_LOCK_MINUTES phút.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15

# --- nạp dữ liệu mẫu ---
# true = seed dữ liệu mẫu khi boot. CHỈ dùng ở dev; production để false.
SEED_ON_BOOT=false

# --- mail (MAIL_MODE=smtp để gửi thật; log để chỉ ghi log; off để im lặng) ---
# smtp mà SMTP_URL trống: app chỉ cảnh báo, thông báo vẫn hiện trên web (arch §19.2-3).
SMTP_URL=
MAIL_FROM=fingate@company.com
MAIL_MODE=smtp

# --- Web Push: thông báo "chờ tôi duyệt" KỂ CẢ KHI APP ĐÃ ĐÓNG (docs/07_pwa-mobile.md) ---
# Sinh cặp khoá MỘT LẦN rồi giữ nguyên (đổi khoá ⇒ mọi thiết bị phải đăng ký lại):
#   npx web-push generate-vapid-keys
# Bỏ trống CẢ HAI ⇒ tính năng tắt êm (app vẫn thông báo khi đang mở, qua chuông poll).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Liên hệ người vận hành — push service dùng khi cần cảnh báo. mailto: hoặc URL.
VAPID_SUBJECT=mailto:admin@fingate.local
# Chu kỳ đẩy trong tiến trình API (giây). 0 = tắt vòng tự động.
PUSH_INTERVAL_SECONDS=30
# false = tạm ngừng gửi mà không xoá khoá.
PUSH_ENABLED=true

# --- bảo mật khi duyệt ---
# Yêu cầu nhập lại mật khẩu/OTP trước khi duyệt/chi (ADR-14). MẶC ĐỊNH TẮT.
APPROVAL_STEP_UP=false

# --- tài khoản quản trị ĐẦU TIÊN (đổi mật khẩu ngay sau lần đăng nhập đầu) ---
BOOTSTRAP_ADMIN_EMAIL=admin@fingate.local
BOOTSTRAP_ADMIN_PASSWORD=doi-mat-khau-nay-ngay
BOOTSTRAP_ADMIN_NAME=Quản trị hệ thống
BOOTSTRAP_ON_BOOT=true

# --- chỉ dùng khi bật Caddy (--profile tls) ---
# PUBLIC_URL phải trùng domain này.
# FINGATE_DOMAIN=fingate.company.com
